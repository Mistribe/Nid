#!/bin/sh
# Nid's backup service (1F2 design §3 to §6). Commands: schedule (default), backup-now, status.
set -eu
. /usr/local/lib/nid-backup/lib.sh

REPO=/repo
SECRETS=/run/backup-secrets
STAGE=/tmp/stage
STATE_DIR=${NID_BACKUP_STATE_DIR:-/tmp/state}
STATE=$STATE_DIR/status.json
SELF=/usr/local/bin/nid-backup
export RESTIC_CACHE_DIR=/tmp/restic-cache
NID_BACKUP_AT=${NID_BACKUP_AT:-03:30}
NID_BACKUP_KEEP=${NID_BACKUP_KEEP:---keep-daily 7 --keep-weekly 4 --keep-monthly 12}
NID_BACKUP_MAX_AGE=${NID_BACKUP_MAX_AGE:-26}
NID_BACKUP_REMOTE_FORGET=${NID_BACKUP_REMOTE_FORGET:-true}
# embedded: Pocket ID runs in this compose and its base is backed up. external: it does not, and nothing of it is.
NID_BACKUP_POCKET_ID=${NID_BACKUP_POCKET_ID:-embedded}
# The Postgres server: this compose's own, or a shared one the backup service can reach on its network.
NID_DB_HOST=${NID_DB_HOST:-postgres}

log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) nid-backup: $*" >&2; }
die() { log "$*"; exit 1; }

local_restic() { restic --repo "$REPO" --password-file "$SECRETS/restic_password" "$@"; }
remote_configured() { [ -s "$SECRETS/remote_repository" ]; }
remote_restic() {
  password=$SECRETS/restic_password
  if [ -s "$SECRETS/remote_password" ]; then password=$SECRETS/remote_password; fi
  if [ -s "$SECRETS/remote_credentials" ]; then export AWS_SHARED_CREDENTIALS_FILE="$SECRETS/remote_credentials"; fi
  restic --repository-file "$SECRETS/remote_repository" --password-file "$password" "$@"
}
# The repository a restore reads: NID_RESTORE_FROM=local (default) or remote.
source_restic() { if [ "${NID_RESTORE_FROM:-local}" = remote ]; then remote_restic "$@"; else local_restic "$@"; fi; }

# ensure_repository local|remote: creates the repository only when restic says it does not exist (exit 10); a
# repository it cannot open for another reason, such as a wrong password, is an error, never a new empty repository.
ensure_repository() {
  rc=0; "$1_restic" cat config >/dev/null 2>&1 || rc=$?
  case $rc in
    0) ;;
    10) log "création du dépôt $1"; "$1_restic" init >/dev/null ;;
    *) log "dépôt $1 illisible (restic : code $rc)"; return 1 ;;
  esac
}

pgpass() { # password file: PGPASSFILE for nid@$NID_DB_HOST/nid
  pgpass_line "$NID_DB_HOST" "$(cat "$1")" > /tmp/pgpass
  chmod 600 /tmp/pgpass
  export PGPASSFILE=/tmp/pgpass
}

# At start: the last success comes from the repository, so a restart does not reset the age; a failed step is kept
# (kept_result), so a restart does not clear the alert either; so is a failed remote while one is configured (kept_remote).
rebuild_status() {
  kept=$(kept_result "$(previous .last_result)")
  configured=no; if remote_configured; then configured=yes; fi
  remote=$(kept_remote "$(previous .remote_result)" "$configured")
  latest=$(local_restic snapshots --host nid --tag nid --latest 1 --json 2>/dev/null || echo '[]')
  time=$(echo "$latest" | jq -r 'sort_by(.time) | last | .time // empty')
  if [ -n "$time" ]; then
    write_status "$kept" "$remote" "$(echo "$latest" | jq -r 'sort_by(.time) | last | .short_id')" "$(iso_to_epoch "$time")"
  else
    write_status "$kept" "$remote" "" ""
  fi
}

# One backup (1F2 design §4), in its own process so that `set -e` holds: a caller's `||` would disable it here.
run_once() {
  started=$(date +%s)
  mkdir -p "$STATE_DIR"
  step() { echo "$1" > "$STATE_DIR/step"; }
  step repository; ensure_repository local
  rm -rf "$STAGE"; mkdir -p "$STAGE"

  step database
  pgpass /source/deploy/secrets/postgres_password
  pg_dump --host="$NID_DB_HOST" --username=nid --dbname=nid --format=custom --file="$STAGE/database.pgdump"
  postgres=$(( $(psql --host="$NID_DB_HOST" --username=nid --dbname=nid -Atc 'show server_version_num') / 10000 ))

  if [ "$NID_BACKUP_POCKET_ID" = embedded ]; then
    step pocket-id
    # Pocket ID's base is SQLite in WAL mode: a hot copy through the backup API, never the live files. Its uploads are
    # plain files; its signing keys live in the base, encrypted with the key in deploy/secrets/.
    sqlite3 "file:/pocket-id/pocket-id.db?mode=ro" ".backup '$STAGE/pocket-id.sqlite3'"
    # The copy lists the running instance as a live host (francis_hosts, cascading to its actors): a restored Pocket ID
    # would refuse to start next to it ("already one instance running") until the row expires.
    sqlite3 "$STAGE/pocket-id.sqlite3" "PRAGMA foreign_keys=ON; DELETE FROM francis_hosts;"
    mkdir -p "$STAGE/pocket-id-uploads"
    if [ -d /pocket-id/uploads ]; then cp -R /pocket-id/uploads/. "$STAGE/pocket-id-uploads/"; fi
  fi

  step manifest
  pg_restore --data-only --file=- "$STAGE/database.pgdump" > /tmp/data.sql
  count_rows < /tmp/data.sql | counts_json > /tmp/counts.json
  dump_migrations < /tmp/data.sql | jq -Rn '[inputs | select(length > 0)]' > /tmp/migrations.json
  rm -f /tmp/data.sql
  keys=$(find /source/volumes/dataprotection-keys -name 'key-*.xml' | wc -l)
  find /source/volumes/dataprotection-keys -name 'key-*.xml' -exec basename {} \; | jq -Rn '[inputs]' > /tmp/keys.json
  jq -n --slurpfile rows /tmp/counts.json --slurpfile migrations /tmp/migrations.json --argjson keys "$keys" \
    --slurpfile key_files /tmp/keys.json \
    --argjson postgres "$postgres" --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg restic "$(restic version | cut -d ' ' -f 2)" --argjson parts "$(backup_parts "$NID_BACKUP_POCKET_ID")" '
    {format: 1, created_at: $created, postgres_major: $postgres, restic_version: $restic,
     parts: $parts,
     migrations: $migrations[0], row_counts: $rows[0], dataprotection_keys: $keys,
     dataprotection_key_files: $key_files[0]}' > "$STAGE/manifest.json"

  step snapshot
  local_restic backup --host nid --tag nid --json "$STAGE" /source > /tmp/backup.json
  summary=$(jq -c 'select(.message_type == "summary")' /tmp/backup.json)
  snapshot=$(echo "$summary" | jq -r '.snapshot_id' | cut -c 1-8)

  step forget
  # shellcheck disable=SC2086 # NID_BACKUP_KEEP is a list of options
  local_restic forget --host nid --tag nid --prune $NID_BACKUP_KEEP >/dev/null
  if [ "$(date +%u)" = 7 ]; then step check; local_restic check >/dev/null; fi

  # A remote failure fails the remote result, never the local backup.
  step remote
  remote=none
  if remote_configured; then
    rc=0; "$SELF" copy-remote "$snapshot" || rc=$?
    case $rc in 0) remote=ok ;; 3) remote=unreachable ;; *) remote=failed ;; esac
  fi

  write_status ok "$remote" "$snapshot" "$(date +%s)"
  rm -rf "$STAGE" /tmp/pgpass
  log "sauvegarde réussie : instantané $snapshot, $(echo "$summary" | jq -r '.data_added') octets ajoutés," \
    "$(( $(date +%s) - started )) s, dépôt distant : $remote"
}

# copy-remote SNAPSHOT: sends one local snapshot to the remote (exit 3: unreachable or unreadable). Bounded: restic
# retries a missing host for minutes, the probe gets 60 s.
copy_remote() {
  rc=0; timeout 60 "$SELF" probe-remote || rc=$?
  case $rc in
    0) ;;
    10) log "création du dépôt distant"; remote_restic init >/dev/null || exit 3 ;;
    *) log "dépôt distant injoignable ou illisible (code $rc)"; exit 3 ;;
  esac
  remote_restic copy --from-repo "$REPO" --from-password-file "$SECRETS/restic_password" "$1" >/dev/null
  if [ "$NID_BACKUP_REMOTE_FORGET" = true ]; then
    # shellcheck disable=SC2086 # NID_BACKUP_KEEP is a list of options
    remote_restic forget --host nid --tag nid --prune $NID_BACKUP_KEEP >/dev/null
  fi
}

# --- restore (1F2 design §6), run in backup-restore with the targets writable ---

snapshot_id() {
  id=$(source_restic snapshots --host nid --tag nid --json "$1" 2>/tmp/restic.err \
    | jq -r 'sort_by(.time) | last | .short_id // empty') || true
  if [ -z "$id" ]; then
    if grep -qi 'wrong password' /tmp/restic.err; then die "mot de passe restic refusé par le dépôt"; fi
    die "aucun instantané « $1 » : $(tail -1 /tmp/restic.err)"
  fi
  echo "$id"
}
manifest() { source_restic dump "$1" /tmp/stage/manifest.json; }

replace_folder() { # restored folder, target folder, owner, folder mode
  find "$2" -mindepth 1 -delete
  cp -a "$1/." "$2/"
  chown -R "$3" "$2"
  chmod "$4" "$2"
}

restore_files() {
  out=/tmp/restore
  rm -rf "$out"; mkdir -p "$out"
  source_restic restore "$1" --target "$out" >/dev/null
  jq -e '.format == 1' "$out/tmp/stage/manifest.json" >/dev/null || die "l'instantané $1 n'a pas de manifeste lisible"
  replace_folder "$out/source/volumes/dataprotection-keys" /target/volumes/dataprotection-keys 1654:1654 700
  replace_folder "$out/source/volumes/assets" /target/volumes/assets 1654:1654 755
  # A snapshot from before the documents existed has no such folder: it held none, so the target is emptied.
  if [ -d "$out/source/volumes/documents" ]; then
    replace_folder "$out/source/volumes/documents" /target/volumes/documents 1654:1654 750
  else
    find /target/volumes/documents -mindepth 1 -delete
  fi
  # The snapshot decides, not the environment: one taken with an external Pocket ID has nothing of it to put back.
  if jq -e '(.parts // ["pocket-id"]) | index("pocket-id")' "$out/tmp/stage/manifest.json" >/dev/null; then
    find /target/volumes/pocket-id -mindepth 1 -delete
    cp "$out/tmp/stage/pocket-id.sqlite3" /target/volumes/pocket-id/pocket-id.db
    mkdir -p /target/volumes/pocket-id/uploads
    cp -a "$out/tmp/stage/pocket-id-uploads/." /target/volumes/pocket-id/uploads/
    chown -R 65532:65532 /target/volumes/pocket-id
    chmod 600 /target/volumes/pocket-id/pocket-id.db
    chmod 700 /target/volumes/pocket-id/uploads
  fi
  # deploy/ goes back to the host user, so deploy/setup.sh can still rewrite it.
  host=${NID_HOST_UID:?}:${NID_HOST_GID:?}
  mkdir -p /target/deploy/secrets
  find /target/deploy/secrets -mindepth 1 -delete
  cp -a "$out/source/deploy/secrets/." /target/deploy/secrets/
  cp "$out/source/deploy/.env" /target/deploy/.env
  chown -R "$host" /target/deploy/secrets
  # The folders too: in --verify they sit in restore.sh's work folder, which the host user must be able to remove.
  chown "$host" /target/deploy/.env
  chmod 700 /target/deploy/secrets
  chmod 644 /target/deploy/secrets/* /target/deploy/.env
  rm -rf "$out"
}

restore_database() {
  pgpass /target/deploy/secrets/postgres_password
  source_restic dump "$1" /tmp/stage/database.pgdump > /tmp/database.pgdump
  pg_restore --host="$NID_DB_HOST" --username=nid --dbname=nid --no-owner --role=nid --exit-on-error /tmp/database.pgdump
  rm -f /tmp/database.pgdump
}

# Row counts of a fresh dump of the restored base against the manifest's: run before nid-api starts, which could write.
check_database() {
  pgpass /target/deploy/secrets/postgres_password
  manifest "$1" | jq '.row_counts' > /tmp/expected.json
  pg_dump --host="$NID_DB_HOST" --username=nid --dbname=nid --format=custom --file=/tmp/now.pgdump
  pg_restore --data-only --file=- /tmp/now.pgdump | count_rows | counts_json > /tmp/actual.json
  rm -f /tmp/now.pgdump
  compare_counts /tmp/expected.json /tmp/actual.json || die "la base restaurée n'a pas les lignes de la sauvegarde"
  echo "$(jq length /tmp/actual.json) tables, autant de lignes que dans la sauvegarde"
}

# Once nid-api is up: every key of the backup is there. nid-api may add one (an old backup's default key expired),
# which is normal; a key of the backup missing would sign everyone out and lose what it encrypted.
check_keys() {
  manifest "$1" > /tmp/manifest.json
  found=$(find /target/volumes/dataprotection-keys -name 'key-*.xml' | wc -l | tr -d ' ')
  if jq -e 'has("dataprotection_key_files")' /tmp/manifest.json >/dev/null; then
    for key in $(jq -r '.dataprotection_key_files[]' /tmp/manifest.json); do
      [ -f "/target/volumes/dataprotection-keys/$key" ] || die "clé Data Protection de la sauvegarde absente : $key"
    done
  else # a backup made before the manifest listed its keys
    [ "$found" -ge "$(jq '.dataprotection_keys' /tmp/manifest.json)" ] || die "clés Data Protection manquantes"
  fi
  echo "$(jq '.dataprotection_keys' /tmp/manifest.json) clé(s) Data Protection de la sauvegarde reprise(s), $found en place"
}

# The local repository belongs to whoever owns its folder on the host (deploy/backups/, created by setup.sh): what
# restic wrote as root goes back to that owner, who can then read and copy the backups without sudo.
give_back_repository() { chown -R "$(stat -c %u:%g "$REPO")" "$REPO"; }

# One run under the lock: a manual run waits for the nightly one instead of failing.
backup_now() {
  mkdir -p "$STATE_DIR"
  (
    flock 9
    rc=0; "$SELF" run-once || rc=$?
    give_back_repository || log "le dépôt local n'a pas pu être rendu à son propriétaire"
    if [ "$rc" -ne 0 ]; then
      failed=$(cat "$STATE_DIR/step" 2>/dev/null || echo inconnue)
      mark_failed "$failed"
      rm -rf "$STAGE" /tmp/pgpass
      log "échec de la sauvegarde à l'étape : $failed"
    fi
    exit "$rc"
  ) 9> /tmp/nid-backup.lock
}

# A configuration the scheduler cannot run with: said once, then the service stays up and unhealthy with the reason.
# Exiting would only make restart: unless-stopped start it again, forever. The status says so too (the API reads it from
# the volume): removing it would resolve the alert, keeping it would leave an earlier healthy one.
config_error() {
  mkdir -p "$STATE_DIR"
  echo "$*" > "$STATE_DIR/configuration"
  mark_failed configuration
  log "$*"
  while :; do sleep 3600; done
}

status() {
  if [ -s "$STATE_DIR/configuration" ]; then cat "$STATE_DIR/configuration"; exit 1; fi
  [ -s "$STATE" ] || { echo "état absent : le service démarre"; exit 1; }
  remote=no; if remote_configured; then remote=yes; fi
  health_check "$STATE" "$(date +%s)" "$NID_BACKUP_MAX_AGE" "$remote" "$(cat "$STATE_DIR/started_at")"
}

schedule() {
  # The state folder is a volume now: a "configuration" message of an earlier start must not outlive its fix.
  mkdir -p "$STATE_DIR"; rm -f "$STATE_DIR/configuration"
  valid_time "$NID_BACKUP_AT" || config_error "NID_BACKUP_AT invalide : $NID_BACKUP_AT (attendu HH:MM, de 00:00 à 23:59)"
  backup_parts "$NID_BACKUP_POCKET_ID" >/dev/null ||
    config_error "NID_BACKUP_POCKET_ID invalide : $NID_BACKUP_POCKET_ID (attendu embedded ou external)"
  [ -s "$SECRETS/restic_password" ] ||
    config_error "restic_password manque dans deploy/backup-secrets/ : relancez deploy/setup.sh"
  mkdir -p "$STATE_DIR"
  date +%s > "$STATE_DIR/started_at"
  rebuild_status
  while :; do
    wait=$(seconds_until "$NID_BACKUP_AT" "$(date +%s)")
    log "prochaine sauvegarde dans $wait s ($NID_BACKUP_AT, fuseau ${TZ:-UTC})"
    sleep "$wait"
    backup_now || true
  done
}

case ${1:-schedule} in
  schedule) schedule ;;
  backup-now) backup_now ;;
  run-once) run_once ;;
  copy-remote) copy_remote "$2" ;;
  probe-remote) remote_restic cat config >/dev/null 2>&1 ;;
  snapshot-id) snapshot_id "${2:-latest}" ;;
  manifest) manifest "$2" ;;
  migrations) manifest "$2" | jq -r '.migrations[]' ;;
  parts) manifest "$2" | jq -r '(.parts // ["pocket-id"])[]' ;;
  restore-files) restore_files "$2" ;;
  restore-database) restore_database "$2" ;;
  check-database) check_database "$2" ;;
  check-keys) check_keys "$2" ;;
  status) status ;;
  *) die "commande inconnue : $1" ;;
esac
