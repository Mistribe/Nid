# cp .env.example .env, then fill in. Never commit .env.

# --- Where Nid and its identity provider are (public https addresses, answered by your reverse proxy)
NID_URL=https://nid.example.org
AUTH_URL=https://auth.example.org

# --- The client of Nid in Pocket ID: redirect https://nid.example.org/auth/callback, sign-out
#     https://nid.example.org/signed-out, PKCE on, consent skipped, restricted to the group nid-users.
NID_OIDC_CLIENT_ID=nid
NID_OIDC_CLIENT_SECRET=

# --- openssl rand -hex 32
NID_CSRF_KEY=

# --- The database. With --profile postgres: leave the host as it is, choose a password.
#     With a Postgres elsewhere (16 or later): its address, and a role that owns an empty database NID_DB_NAME, nothing more:
#       CREATE ROLE nid LOGIN PASSWORD '...'; CREATE DATABASE nid OWNER nid; REVOKE ALL ON DATABASE nid FROM PUBLIC;
NID_DB_HOST=postgres
NID_DB_PORT=5432
NID_DB_NAME=nid
NID_DB_USER=nid
NID_DB_PASSWORD=

# --- Where nid listens on the host (your reverse proxy points here)
NID_WEB_BIND=127.0.0.1
NID_WEB_PORT=8080

# --- Only with --profile pocket-id: openssl rand -base64 32 (losing it makes Pocket ID's base unreadable), and where it listens
POCKET_ID_ENCRYPTION_KEY=
POCKET_ID_BIND=127.0.0.1
POCKET_ID_PORT=1411

# --- Optional: another image (a version tag instead of latest)
# NID_IMAGE=oriondev.azurecr.io/mistribe/nid:latest
