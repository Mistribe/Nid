---
// One screen of the app, in the visitor's theme: the light and the dark capture of src/assets/screens/<name>-{light,dark}.png,
// one of them hidden by Starlight's theme classes.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { name: string; alt: string; eager?: boolean }
const { name, alt, eager = false } = Astro.props;
const captures = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', { eager: true });
const capture = (mode: 'light' | 'dark') => {
  const file = captures[`../assets/screens/${name}-${mode}.png`];
  if (!file) throw new Error(`No capture src/assets/screens/${name}-${mode}.png`);
  return file.default;
};
const loading = eager ? 'eager' : 'lazy';
---
<figure class="screen not-content">
  <Image class="dark:sl-hidden" src={capture('light')} alt={alt} widths={[686, 1372]} sizes="(max-width: 72rem) 100vw, 72rem" loading={loading} />
  <Image class="light:sl-hidden" src={capture('dark')} alt={alt} widths={[686, 1372]} sizes="(max-width: 72rem) 100vw, 72rem" loading={loading} />
</figure>

<style>
  .screen {
    margin: 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 18px 48px -16px color-mix(in oklch, var(--sl-color-accent) 45%, transparent);
  }
  /* No `display` here: it would beat the sl-hidden that keeps one of the two captures out of each theme. */
  .screen :global(img) { width: 100%; height: auto; vertical-align: bottom; }
</style>
