# nid-web (1F1 design §2.2): the SPA and the single origin. TLS is the hoster's; this listens on plain HTTP.
{
	admin off
	auto_https off
	persist_config off
	servers {
		# The hoster's proxy is on a private network: trust the X-Forwarded-* it sets, which reverse_proxy then passes
		# on to nid-api (whose own middleware trusts only this container's network, Auth:TrustedNetworks).
		trusted_proxies static private_ranges
	}
}

:8080 {
	@api path /api /api/* /auth /auth/* /mcp /mcp/* /health /health/*
	handle @api {
		reverse_proxy nid-api:8080
	}

	# Hashed build files never change. A missing one is a 404, never the SPA: after an upgrade, a browser asking for an old
	# chunk must not get index.html cached for a year (1F1 final review).
	handle /assets/* {
		root * /srv
		import /etc/caddy/headers.caddy
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: the file if it exists, else the SPA, always revalidated.
	handle {
		root * /srv
		import /etc/caddy/headers.caddy
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
