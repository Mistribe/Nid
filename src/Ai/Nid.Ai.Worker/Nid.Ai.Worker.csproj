<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- A few requests at a time on a small box: the workstation GC keeps less memory. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- The image is the plain chiseled one, without ICU: nothing the worker writes depends on a culture. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nid.Ai.Protocol\Nid.Ai.Protocol.csproj" />
  </ItemGroup>
</Project>
