<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- NidApp: the real host over a test database, shared by every module's integration tests. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <ProjectReference Include="..\..\src\Nid.Banking.Contracts\Nid.Banking.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Nid.Core.Infrastructure\Nid.Core.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Nid.Subscriptions.Infrastructure\Nid.Subscriptions.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Nid.Investments.Infrastructure\Nid.Investments.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Nid.Income.Infrastructure\Nid.Income.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Nid.RealEstate.Infrastructure\Nid.RealEstate.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Nid.Platform.Infrastructure\Nid.Platform.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Nid.Documents.Application\Nid.Documents.Application.csproj" />
    <ProjectReference Include="..\..\src\Nid.Documents.Infrastructure\Nid.Documents.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Nid.Host\Nid.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copied into the output of every integration test project that references this one. -->
    <None Include="..\fixtures\**\*" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\vectors\prices\*" LinkBase="vectors\prices" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\vectors\irl\*" LinkBase="vectors\irl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
