<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A PackageVersion also pins the package where it only comes transitively (EF Core below). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="NodaTime" Version="3.3.7" />
    <PackageVersion Include="UnambitiousFx.Functional" Version="4.0.1" />
    <PackageVersion Include="UnambitiousFx.Functional.AspNetCore" Version="4.0.1" />
    <PackageVersion Include="UnambitiousFx.Myelin" Version="1.2.0" />
    <!-- RFC 9421 HTTP message signatures between Nid and its model workers (src/Ai/Nid.Ai.Protocol). -->
    <PackageVersion Include="NSign.AspNetCore" Version="1.2.8" />
    <PackageVersion Include="NSign.Client" Version="1.2.8" />
    <PackageVersion Include="NSign.SignatureProviders" Version="1.2.8" />
    <PackageVersion Include="UnambitiousFx.Engram" Version="1.1.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <!-- Npgsql 10.0.3 brings EF Core 10.0.4; the Design tooling needs the same EF Core as the runtime (MSB3277). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="AWSSDK.S3" Version="4.1.2" />
    <PackageVersion Include="UnambitiousFx.Synapse" Version="3.6.0" />
    <PackageVersion Include="UnambitiousFx.Synapse.Abstractions" Version="3.6.0" />
    <PackageVersion Include="UnambitiousFx.Synapse.Authorization" Version="3.6.0" />
    <PackageVersion Include="UnambitiousFx.Synapse.Generator" Version="3.6.0" />
    <PackageVersion Include="UnambitiousFx.Synapse.ModelContextProtocol" Version="3.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- Nid.TestSupport is a library, not a test suite: the fixtures and assertions without the xunit.v3 runner. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.3" />
    <!-- Same version as the Microsoft.Testing.Platform that xunit.v3 brings. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
    <!-- Its own version line (18.x), built against Microsoft.Testing.Platform 2.5. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageVersion Include="Quartz" Version="4.7.3" />
    <!-- Rotated log files (#267): Microsoft.Extensions.Logging has no file provider. -->
    <PackageVersion Include="Serilog.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <!-- 1C2c: icon decoding and lossless WebP encoding (MIT). SkiaSharp brings its macOS and Windows native libraries;
         the Linux one (CI, the 1F image) is the no-dependencies build: it needs glibc and libstdc++, nothing else. -->
    <PackageVersion Include="SkiaSharp" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
    <!-- #181: read_document renders a PDF's pages for the assistant (MIT, PDFium + SkiaSharp). -->
    <PackageVersion Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>
</Project>
